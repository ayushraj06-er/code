#include<iostream>
        using namespace std;
        int firstOneIdx(int arr[],int row,int col){
               int st=0;
               int end=col-1; 
               while(st<=end){
                int mid=(st+end)/2;
                if(arr[mid]==1){
                        end=mid-1;
                }else{
                        st=mid+1;
                }
               }
               return st;
        }
        int findMaxOne(int mat[][3],int row,int col){
                int maxOne=-1;
               int idx=-1;
               for(int i=0;i<row;i++){
                        int cnt=0;
                        int x=firstOneIdx(mat[i],row,col);
                        cnt=col-x;
                        if(cnt>maxOne){
                                maxOne=cnt;
                                idx=i;
                        }   

               }
               return idx;
        }
        int main(){
                int mat[][3]={{1,1,1},{0,0,1},{1,1,1}};
                int row=3;
                int col=3;
                cout<<findMaxOne(mat,row,col);
                return 0;
        }
        
