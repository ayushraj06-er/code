#include<iostream>
#include<map>
using namespace std;
int cntSubArr(int arr[],int n,int k){
    map<int,int>m;
    int ps=0;
    int maxLength=0;
    for(int i=0;i<n;i++){
        ps+=arr[i];
        if(ps==k){
            maxLength=max(maxLength,i+1);
        }
        if(m.find(ps-k)!=m.end()){
            int l=i-m[ps-k];
            maxLength=max(l,maxLength);
        }
        m[ps]=i;

    }
    return maxLength;

}
int main(){
    int arr[]={10, 5, 2, 7, 1, 9};
    int n=sizeof(arr)/sizeof(arr[0]);
    int k=15;
    cout<<cntSubArr(arr,n,k);
    return 0;
}
