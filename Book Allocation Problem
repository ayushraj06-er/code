class Solution {
public:

    int returnSum(vector<int>&arr,int n){
        int sum=0;
        for(int i=0;i<n;i++){
            sum+=arr[i];
        }
        return sum;
    }
    int cntStudent(vector<int> &arr,int mid,int n){
        int stu=1;
        int tp=0;
        for(int i=0;i<n;i++){
            if(tp+arr[i]<=mid){
                tp+=arr[i];
            }else{
                stu++;
                tp=arr[i];
            }
        }
        return stu;
    }
    int findPages(vector<int> &arr, int m)  {
        int n=arr.size();
        int low=*max_element(arr.begin(),arr.end());
        int high=returnSum(arr,n);
        if(m>n)return -1;
        while(low<=high){
        int mid=(low+high)/2;
        int count=cntStudent(arr,mid,n);
        if(count<=m){
            high=mid-1;
        }else{
            low=mid+1;
        }

    }
    return low;
    }
};
